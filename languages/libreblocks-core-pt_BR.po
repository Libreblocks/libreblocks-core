# Requisitos
msgid "LibreBlocks requires PHP %1$s or newer. This site runs PHP %2$s."
msgstr "O LibreBlocks requer PHP %1$s ou mais recente. Este site usa PHP %2$s."

msgid "LibreBlocks requires WordPress %1$s or newer. This site runs WordPress %2$s."
msgstr "O LibreBlocks requer WordPress %1$s ou mais recente. Este site usa WordPress %2$s."

msgid "%1$s needs LibreBlocks Core %2$s or newer. Please update LibreBlocks Core."
msgstr "O %1$s precisa do LibreBlocks Core %2$s ou mais recente. Atualize o LibreBlocks Core."

# Admin
msgid "LibreBlocks"
msgstr "LibreBlocks"

msgid "Dashboard"
msgstr "Painel"

msgid "LibreBlocks admin assets are missing. Run \"npm install && npm run build\" inside libreblocks-core."
msgstr "Os arquivos do painel do LibreBlocks estão faltando. Execute \"npm install && npm run build\" na pasta libreblocks-core."

